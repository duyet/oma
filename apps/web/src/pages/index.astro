---
import Base from "../layouts/Base.astro";
import { softwareApplicationSchema } from "../lib/seo";
import Logo from "../components/Logo.astro";
import HowItFits from "../components/HowItFits.astro";
import WiredFlows from "../components/WiredFlows.tsx";
import ProviderFan from "../components/ProviderFan.astro";
import Icon from "../components/Icon.astro";

// SoftwareApplication is the homepage-only schema — anchors the
// "Open Managed Agents" entity in Google's knowledge graph and makes
// the page eligible for software-style rich snippets (price, license).
const schemas = [softwareApplicationSchema()];

// Shared button recipes. shadcn's own button variants at the preset radius
// (0.625rem → rounded-md); previously each anchor carried a 400-char inline
// copy of these, which drifted between call sites.
const btnPrimary =
  "inline-flex h-9 items-center justify-center gap-1.5 whitespace-nowrap rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground no-underline transition-colors hover:bg-primary/90 hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 [&_svg]:shrink-0";
const btnOutline =
  "inline-flex h-9 items-center justify-center gap-1.5 whitespace-nowrap rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground no-underline transition-colors hover:bg-muted hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 [&_svg]:shrink-0";

// Section frame — mirrors AnyRouter's SectionShell rhythm: hairline top
// border, generous vertical padding, left-aligned mono eyebrow + tight
// semibold title + max-w-2xl intro. No banded fills; the page is white
// throughout and sections are separated by the hairline alone.
const section = "border-t border-border py-12 sm:py-16 lg:py-24";
const container = "max-w-5xl mx-auto px-4";
const eyebrow =
  "font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--color-brand)]";
const sectionTitle =
  "mt-3 max-w-2xl text-balance text-[1.625rem] font-semibold tracking-tighter text-[var(--color-fg)] sm:text-3xl lg:text-4xl";
const sectionIntro =
  "mt-3 max-w-2xl text-pretty text-sm leading-relaxed text-[var(--color-fg-muted)] sm:text-base";

const concepts = [
  {
    name: "Agent",
    body: "A versioned config: model, prompt, tools, skills, MCP, harness. Sessions pin a version at creation; updates never rewrite live runs.",
  },
  {
    name: "Session",
    body: "A conversation backed by an append-only event log. Streaming, crash recovery, and lifecycle all hang off this durable state.",
  },
  {
    name: "Environment",
    body: "The execution sandbox: packages, network policy, container image. Reusable across agents, so a fleet shares one runtime shape.",
  },
  {
    name: "Vault",
    body: "A credential store that never enters the sandbox. An outbound proxy injects tokens at the network layer, matched by URL.",
  },
];

// The durable request path, as an ordered pipeline. Rendered as a node row
// joined by connector rails.
const requestPath = [
  { icon: "workflow", name: "Request", sub: "user.message (SSE)" },
  { icon: "layers", name: "Session", sub: "event log · DO-SQLite" },
  { icon: "repeat", name: "Harness", sub: "model loop · tools" },
  { icon: "box", name: "Sandbox", sub: "bash · read · write · MCP" },
  { icon: "globe", name: "Vault proxy", sub: "injects creds" },
] as const;

// Deep-dive pages split off the landing page — a compact link row so the
// relocated sections stay discoverable.
const explore = [
  { title: "How it works", href: "/how-it-works/", icon: "layers", body: "The meta-harness design, architecture layers, and the durable session lifecycle." },
  { title: "Features", href: "/features/", icon: "grid", body: "Everything the platform gives you — and why it's drop-in compatible." },
  { title: "Use cases", href: "/use-cases/", icon: "workflow", body: "Real workflows: ship code, run production, answer customers, work a thread." },
  { title: "Infrastructure", href: "/infrastructure/", icon: "server", body: "Multi-agent fleets, any sandbox provider, and bridging your own machine." },
] as const;
---

<Base
  title="oma — Open Managed Agents: self-hosted agent platform for any LLM provider and any sandbox"
  description="oma (Open Managed Agents) is an open-source, self-hostable agent platform — durable sessions, sandboxed execution, MCP tools — that runs on any LLM provider (Anthropic, OpenAI-compatible gateways, or your own model) and any sandbox platform (Cloudflare Containers, Kubernetes, E2B, Daytona, subprocess, or a WASM VM in your browser tab), on Cloudflare Workers or Docker."
  canonical="/"
  keywords="open managed agents, oma agent platform, self host ai agent, any llm provider agent platform, byok ai agent, claude agent sdk, mcp server host, ai agent cloudflare workers, self host claude code, claude code skills, claude managed agents alternative, claude tag alternative, open source claude tag"
  schemas={schemas}
>
  {/* Hero — the assembly diagram leads, full width: it is the product's
      mental model and the thing worth seeing first. The pitch sits directly
      under it. Breaks out wider than the text column on large screens. */}
  <section class:list={[container, "pt-10 pb-12 sm:pt-12 sm:pb-16 lg:pt-14 lg:pb-24"]}>
    <div class="mb-12 lg:-mx-20 xl:-mx-32">
      <HowItFits />
    </div>

    <div class="max-w-3xl">
      <h1
        class="text-balance text-[2.125rem] font-semibold leading-[1.08] tracking-tighter text-[var(--color-fg)] sm:text-[2.75rem] lg:text-[3.25rem]"
      >
        The self-hosted agent platform for any LLM provider and any sandbox
      </h1>
      <p
        class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-[var(--color-fg-muted)] sm:text-lg"
      >
        Run your own agents on any model, in any sandbox. Deploy to Cloudflare
        Workers, or run it yourself with Docker.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/duyet/oma"
          target="_blank"
          rel="noopener noreferrer"
          class={btnPrimary}><Icon name="download" size={16} /> Clone the repo</a
        >
        <a href="https://docs.oma.duyet.net" class={btnOutline}
          ><Icon name="book" size={16} /> Read the docs</a
        >
      </div>

      <p class="mt-6 text-sm text-[var(--color-fg-subtle)]">
        Apache 2.0 · self-hostable · no vendor lock-in
      </p>
    </div>
  </section>

  {/* Primitives — the four objects that carry the whole model. */}
  <section class={section} data-reveal id="what-is-oma">
    <div class={container}>
      <header class="mb-8 sm:mb-10">
        <p class={eyebrow}>Product</p>
        <h2 class={sectionTitle}>What Open Managed Agents is</h2>
        <p class={sectionIntro}>
          A platform for running agent fleets, not a chat UI. Four primitives
          carry the whole model.
        </p>
      </header>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          concepts.map((c) => (
            <article
              data-lift
              class="rounded-xl border border-border bg-[var(--color-card)] p-6"
            >
              <h3 class="text-lg font-semibold tracking-tight text-[var(--color-fg)]">
                {c.name}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-[var(--color-fg-muted)]">
                {c.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Example — the interactive flow demo. */}
  <section class={section} data-reveal id="example">
    <div class={container}>
      <header class="mb-8 sm:mb-10">
        <p class={eyebrow}>Example</p>
        <h2 class={sectionTitle}>See it run</h2>
        <p class={sectionIntro}>
          Pick a use case and follow its trigger → agent → result pipeline,
          including the local bridge relay, Kubernetes, and the browser sandbox.
        </p>
      </header>
      <WiredFlows client:load />
    </div>
  </section>

  {/* Anatomy — the durable request path as an ordered pipeline. */}
  <section class={section} data-reveal id="architecture">
    <div class={container}>
      <header class="mb-8 sm:mb-10">
        <p class={eyebrow}>Anatomy</p>
        <h2 class={sectionTitle}>What one request touches</h2>
        <p class={sectionIntro}>
          Every message runs the same durable path. The session's append-only
          event log records it, the harness drives the model loop, tools execute
          in the sandbox, and the outbound proxy injects vault credentials the
          sandbox never sees.
        </p>
      </header>
      <div class="overflow-x-auto pb-2">
        <ol class="arch-path">
          {
            requestPath.map((n) => (
              <li class="arch-node">
                <span class="arch-node-glyph"><Icon name={n.icon} size={20} /></span>
                <span class="arch-node-name">{n.name}</span>
                <span class="arch-node-sub">{n.sub}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="mt-6 text-sm text-[var(--color-fg-subtle)]">
        The replayable event log is what makes a crashed turn resumable.
      </p>
    </div>
  </section>

  {/* Reach — any provider in, any sandbox out. */}
  <section class={section} data-reveal id="reach">
    <div class={container}>
      <header class="mb-8 sm:mb-10">
        <p class={eyebrow}>Reach</p>
        <h2 class={sectionTitle}>Any model, any sandbox</h2>
        <p class={sectionIntro}>
          The control plane is the constant. Point it at Anthropic, any
          OpenAI-compatible gateway, or your own model; run tools on Cloudflare
          Containers, Kubernetes, an OpenShell bridge, a WASM VM in a browser
          tab, your own machine over the CLI, or a micro-VM vendor. In the
          middle, one durable spine owns context, state, and memory — so the
          session survives whichever model or sandbox you swap in.
        </p>
      </header>
      <ProviderFan />
    </div>
  </section>

  {/* Explore — links into the deep-dive pages split off this page. */}
  <section class={section} data-reveal id="explore">
    <div class={container}>
      <header class="mb-8 sm:mb-10">
        <p class={eyebrow}>Explore</p>
        <h2 class={sectionTitle}>Dig deeper</h2>
        <p class={sectionIntro}>
          The details live on their own pages — pick a thread to pull.
        </p>
      </header>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          explore.map((e) => (
            <a
              href={e.href}
              data-lift
              class="block rounded-xl border border-border bg-[var(--color-card)] p-6 no-underline hover:no-underline"
            >
              <div class="mb-2 flex items-center gap-2.5">
                <Icon name={e.icon} size={18} class="text-[var(--color-brand)]" />
                <h3 class="text-base font-semibold tracking-tight text-[var(--color-fg)]">
                  {e.title}
                </h3>
                <span class="ml-auto text-[var(--color-fg-subtle)]">→</span>
              </div>
              <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">{e.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* Get started */}
  <section class={section} data-reveal id="get-started">
    <div class:list={[container, "text-center"]}>
      <Logo size={56} class="mx-auto mb-6 block text-[var(--color-brand)]" />
      <h2 class="text-[1.625rem] font-semibold tracking-tighter text-[var(--color-fg)] sm:text-3xl">
        Get started
      </h2>
      <p class="mx-auto mt-3 max-w-md text-pretty text-sm leading-relaxed text-[var(--color-fg-muted)] sm:text-base">
        Clone, deploy, or try the hosted deployment of the same codebase.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://github.com/duyet/oma"
          target="_blank"
          rel="noopener noreferrer"
          class={btnPrimary}><Icon name="download" size={16} /> Clone the repo</a
        >
        <a href="https://docs.oma.duyet.net" class={btnOutline}
          ><Icon name="book" size={16} /> Read the docs</a
        >
        <a href="https://app.oma.duyet.net/login" class={btnOutline}
          ><Icon name="server" size={16} /> Try hosted</a
        >
      </div>
    </div>
  </section>
</Base>
