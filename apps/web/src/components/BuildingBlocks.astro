---
import Icon from "./Icon.astro";

const blocks: { name: string; icon: "book" | "globe" | "box"; body: string }[] = [
  {
    name: "Skills",
    icon: "book",
    body: "Reusable prompt fragments + files mounted into the sandbox and injected into the system prompt. Write once, attach to any number of agents; versioned and auditable.",
  },
  {
    name: "MCP servers",
    icon: "globe",
    body: "Connect remote MCP servers — GitHub, Linear, Firecrawl, anything. Every call is proxied through the control plane, the only layer that holds the upstream credential; the sandbox never sees it.",
  },
  {
    name: "Artifacts",
    icon: "box",
    body: "What agents produce: files in /workspace, memory-store notes, generated reports/charts, opened PRs. An agent can mark a keep-this deliverable with the opt-in output_file tool (`agent.output_declared`); those land in the session event log and the Console Artifacts tab.",
  },
];
---

<section class="border-t border-border py-10 sm:py-12" data-reveal>
  <div class="site-container">
    <header class="mb-6 sm:mb-8">
      <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-primary">
        Building blocks
      </p>
      <h2 class="mt-3 text-balance text-[1.6rem] font-semibold tracking-tighter text-foreground sm:text-[2.1rem]">
        Skills, MCP, artifacts
      </h2>
      <p class="mt-2 max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground sm:text-base">
        What an agent assembles: reusable know-how (skills), external tools over
        MCP, and durable outputs (artifacts) that land in the session log.
      </p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        blocks.map((b) => (
          <article
            data-lift
            class="rounded-2xl border border-border bg-card p-4 transition-colors hover:border-border/80"
          >
            <div class="mb-3 flex items-center gap-2.5">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={b.icon} size={18} />
              </div>
              <h3 class="text-base font-semibold tracking-tight text-foreground">
                {b.name}
              </h3>
            </div>
            <p class="text-sm leading-relaxed text-muted-foreground">{b.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
