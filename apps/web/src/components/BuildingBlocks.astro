---
// "Skills, MCP, Artifacts" — the building blocks an agent wires together.
// Compact 3-up card row consistent with the rest of the landing sections.
import Icon from "./Icon.astro";

const blocks = [
  {
    name: "Skills",
    icon: "book",
    body: "Reusable prompt fragments + files mounted into the sandbox and injected into the system prompt. Write once, attach to any number of agents; versioned and auditable.",
  },
  {
    name: "MCP servers",
    icon: "globe",
    body: "Connect remote MCP servers — GitHub, Linear, Firecrawl, anything. Every call is proxied through the control plane, the only layer that holds the upstream credential; the sandbox never sees it.",
  },
  {
    name: "Artifacts",
    icon: "box",
    body: "What agents produce: files in /workspace, memory-store notes, generated reports/charts, opened PRs. All land in the session's event log and surface as replayable outputs.",
  },
];
---

<section class="border-t border-border py-10 sm:py-12" data-reveal>
  <div class="max-w-5xl mx-auto px-4">
    <header class="mb-6 sm:mb-8">
      <p
        class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--color-brand)]"
      >
        Compose
      </p>
      <h2
        class="mt-3 text-balance text-[1.6rem] font-semibold tracking-tighter text-[var(--color-fg)] sm:text-[2.1rem]"
      >
        Skills, MCP, Artifacts
      </h2>
      <p
        class="mt-2 max-w-2xl text-pretty text-sm leading-relaxed text-[var(--color-fg-muted)] sm:text-base"
      >
        The building blocks an agent assembles: know-how that ships with prompts,
        external tools over MCP, and the durable outputs it produces.
      </p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        blocks.map((b) => (
          <article
            data-lift
            class="rounded-xl border border-border bg-[var(--color-card)] p-5"
          >
            <div class="mb-3 flex items-center gap-2.5">
              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[var(--color-brand-subtle)] text-[var(--color-brand)]"
              >
                <Icon name={b.icon} size={18} />
              </div>
              <h3
                class="text-base font-semibold tracking-tight text-[var(--color-fg)]"
              >
                {b.name}
              </h3>
            </div>
            <p class="text-sm leading-relaxed text-[var(--color-fg-muted)]">
              {b.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
