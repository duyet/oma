{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oma-sandbox-default",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Local `pnpm dev`: do not declare `containers` here. Wrangler 4.83
  // always tries to docker-build declared container images, and
  // `dev.enable_containers` / `--enable-containers` landed in later
  // wrangler. Production wrangler.jsonc uses `./Dockerfile.sandbox`.
  "dev": {
    "enable_containers": false
  },

  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },

  // Same KV as main worker — share agent/env/session config
  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "5e49bdaec1884f5989037c86ece7b462" }
  ],

  "vars": {
    "MEMORY_BUCKET_NAME": "oma-managed-agents-memory",
    "WORKSPACE_BUCKET_NAME": "oma-managed-agents-workspace",
    "BACKUP_BUCKET_NAME": "oma-managed-agents-backups",
    "CLOUDFLARE_ACCOUNT_ID": "44af79e51582ca20c9003eb926540242"
  },

  "r2_buckets": [
    { "binding": "WORKSPACE_BUCKET", "bucket_name": "oma-managed-agents-workspace" },
    { "binding": "FILES_BUCKET", "bucket_name": "oma-managed-agents-files" },
    // Memory store mount target. In wrangler dev this resolves to the local
    // wrangler R2 simulator; sandbox.mountBucket(..., { localBucket: true })
    // performs bidirectional sync via the binding.
    { "binding": "MEMORY_BUCKET", "bucket_name": "oma-managed-agents-memory" }
  ],

  // MAIN service binding so AcpProxyHarness can call into the main worker's
  // /v1/internal/runtime-attach-harness endpoint to reach RuntimeRoom DO.
  "services": [
    { "binding": "MAIN", "service": "oma-managed-agents" }
  ],

  // Browser Rendering is always-remote (prompts for a CF account). Omit it
  // for local simulators; the browser tool is already opt-in in agent config.

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "Sandbox"]
    }
  ],

  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true }
}
