{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oma-managed-agents",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // ─────────────────────────────────────────────────────────────────────
  // SELF-HOST BASELINE
  // ─────────────────────────────────────────────────────────────────────
  // The top-level config is the self-host single-D1 deployment shape:
  // one auth D1, one integrations D1, one KV, two R2s, no sharding.
  // `<set-by-setup-cf-sh>` placeholders are filled in by scripts/setup-cf.sh
  // when a fresh user runs the setup wizard.
  //
  // oma.duyet.net's multi-shard production overrides ALL bindings via the
  // env.production overlay below. Run `wrangler deploy --env production`
  // (or `--env staging`) for the hosted deployments.
  // ─────────────────────────────────────────────────────────────────────

  "assets": {
    "directory": "../console/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/v1/*",
      "/auth/*",
      "/auth-info",
      "/health",
      "/linear/*",
      "/linear-setup/*",
      "/agents/runtime/*",
      "/billing-api/*",
      // Public chat surface (issue #178): the worker owns /p/* — the hosted
      // chat page, widget.js, and session/SSE endpoints. Without this the
      // ASSETS SPA fallback would serve the Console index.html for /p/<slug>
      // and a visitor would land on the operator login instead of the bot.
      "/p/*",
      // Browser-VM sandbox host (docs/browser-vm-sandbox.md): the worker
      // serves a COOP/COEP HTML page from browser-vm-host.ts. Without this,
      // Assets SPA fallback serves Console index.html → React catch-all
      // Navigate to /agents, so "Open sandbox tab" never reaches the host.
      "/sandbox-tab",
      "/sandbox-tab/*"
    ]
  },

  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "<set-by-setup-cf-sh>" }
  ],

  // Public origin of the integrations gateway. For self-host this is
  // typically https://integrations.<your-domain> or the integrations
  // worker's *.workers.dev URL. setup-cf.sh fills it in.
  "vars": {
    "INTEGRATIONS_ORIGIN": "<set-by-setup-cf-sh>",
    "TURNSTILE_SITE_KEY": ""
  },

  "r2_buckets": [
    { "binding": "FILES_BUCKET", "bucket_name": "oma-managed-agents-files" },
    // Bytes-of-truth for memory store content. Each memory is keyed
    // <store_id>/<memory_path>. R2 Event Notifications on this bucket
    // route to MEMORY_EVENTS_QUEUE; the queue consumer in this worker
    // reflects writes back to D1 (memories index + memory_versions audit).
    { "binding": "MEMORY_BUCKET", "bucket_name": "oma-managed-agents-memory" }
  ],

  // D1 layout — single-D1 self-host baseline. MAIN_DB holds everything
  // (control plane + tenant data); INTEGRATIONS_DB holds the
  // linear/github/slack tables. Auto-detection in
  // packages/services/src/index.ts buildCfTenantDbProvider() falls back
  // to CfSharedAuthDbProvider when AUTH_DB_01 isn't bound, so signup
  // and routing work without any shard tables.
  "d1_databases": [
    { "binding": "MAIN_DB",         "database_name": "oma-auth",         "database_id": "<set-by-setup-cf-sh>" },
    { "binding": "INTEGRATIONS_DB", "database_name": "oma-integrations", "database_id": "<set-by-setup-cf-sh>", "migrations_dir": "migrations-integrations" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RUNTIME_ROOM", "class_name": "RuntimeRoom" }
    ]
  },

  // Cloudflare Email Service (public beta) — transactional email
  "send_email": [
    { "name": "SEND_EMAIL" }
  ],

  // Workers AI for generating embeddings
  "ai": { "binding": "AI" },

  // Service bindings to agent + integrations workers. USAGE_METER is a
  // hosted-only binding (packages/billing/) and is added in
  // env.production below — the OSS Env declares the duck-typed contract
  // so canStartSandbox / recordUsage soft-skip when missing.
  "services": [
    { "binding": "SANDBOX_sandbox_default", "service": "oma-sandbox-default" },
    { "binding": "INTEGRATIONS", "service": "oma-managed-agents-integrations" }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO", "Sandbox"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["SessionDO", "Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["BuilderSandbox"]
    },
    {
      "tag": "v4",
      "deleted_classes": ["BuilderSandbox"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["RuntimeRoom"]
    }
  ],

  // cpu_ms requires Workers Paid (100328 on Free). Keep unset at top-level
  // so env.production deploys do not inherit a CPU limit the account rejects.
  // "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },

  // Analytics Engine for structured error/event metrics. Dataset is created
  // automatically on first write — no dashboard pre-step needed. Query via
  // Cloudflare's SQL API or the Grafana plugin. Schema convention lives in
  // packages/shared/src/metrics.ts (column positions are load-bearing).
  // Live prod worker already binds ANALYTICS → oma_events (same name).
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "oma_events" }
  ],

  // Cross-isolate rate limiting via CF Workers Rate Limiting binding.
  // Replaces a per-isolate Map limiter that under-counted N×isolate.
  // CF only supports period 10 or 60 (seconds); pick limits accordingly.
  // namespace_ids are arbitrary tenant-scoped numeric tokens — they only
  // need to be unique within this worker.
  "ratelimits": [
    { "name": "RL_AUTH_IP",         "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AUTH_SEND_IP",    "namespace_id": "1002", "simple": { "limit": 5,  "period": 60 } },
    { "name": "RL_AUTH_SEND_EMAIL", "namespace_id": "1003", "simple": { "limit": 1,  "period": 60 } },
    { "name": "RL_API_USER_WRITE",  "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_API_USER_READ",   "namespace_id": "1005", "simple": { "limit": 600,"period": 60 } },
    { "name": "RL_SESSIONS_TENANT", "namespace_id": "1006", "simple": { "limit": 5,  "period": 60 } },
    { "name": "RL_UPLOAD_TENANT",   "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_MAGICLINK_EMAIL", "namespace_id": "1008", "simple": { "limit": 1,  "period": 60 } },
    { "name": "RL_MCP_PROXY_TENANT","namespace_id": "1009", "simple": { "limit": 300,"period": 60 } }
  ],

  // Cloudflare Queue consumer for R2 Event Notifications on MEMORY_BUCKET.
  // R2 fires { action, bucket, object: { key, size, eTag } } per write/delete;
  // the consumer in apps/main/src/queue/memory-events.ts derives store_id+path
  // from the key, dedupes by (store_id, path, etag), and writes:
  //   - memories index row (UPSERT)
  //   - memory_versions audit row (INSERT)
  // R2 → Queue subscription itself is NOT in wrangler — set it up via:
  //   wrangler r2 bucket notification create oma-managed-agents-memory \
  //     --event-type object-create object-delete \
  //     --queue oma-managed-agents-memory-events
  // Local dev: R2 events do NOT fire (CF control-plane feature). REST writes
  // still audit (inline write to D1 in the route handler), but agent FUSE
  // writes are not audited in dev. Documented in README.
  "queues": {
    "consumers": [
      {
        "queue": "oma-managed-agents-memory-events",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "oma-managed-agents-memory-events-dlq"
      },
      {
        // DLQ subscriber for the main queue above. Captures messages that
        // exhausted retries (D1 outage, malformed key, code regression),
        // logs + records to AE so they don't disappear silently. Handler
        // ALWAYS acks — there's no DLQ-of-DLQ in CF Queues, and a thrown
        // handler here would loop until expiry.
        "queue": "oma-managed-agents-memory-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 1
      }
    ]
  },

  "triggers": {
    "crons": ["* * * * *", "0 */6 * * *"]
  },

  // ─────────────────────────────────────────────────────────────────────
  // ENVIRONMENT OVERLAYS (hosted)
  // ─────────────────────────────────────────────────────────────────────
  // wrangler v4 env overlays REPLACE the top-level bindings entirely, so
  // each env block re-declares every binding it needs. This keeps the
  // self-host baseline (top-level) decoupled from oma.duyet.net's hosted
  // multi-shard prod.
  // ─────────────────────────────────────────────────────────────────────

  "env": {
    "production": {
  "name": "oma-managed-agents",
      // Custom domain for the main API + bundled Console UI (assets.directory
      // above). oma.duyet.net is a subdomain of the duyet.net zone, which is
      // on this account, so Cloudflare auto-creates the DNS record + route.
      "routes": [
        { "pattern": "app.oma.duyet.net", "custom_domain": true }
      ],
      "vars": {
        "INTEGRATIONS_ORIGIN": "https://integrations.oma.duyet.net",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADDow0APKUYcuXMp"
      },
      "kv_namespaces": [
        { "binding": "CONFIG_KV", "id": "6adfd1b06ee6493981b4b818d3dd81ae" }
      ],
      // R2 / AE / memory-event queues are intentionally omitted from
      // env.production until the account re-enables R2 (CF API code 10042 —
      // "Please enable R2 through the Cloudflare Dashboard"). Live
      // oma-managed-agents already runs without FILES_BUCKET / MEMORY_BUCKET /
      // ANALYTICS / queue consumers (verified via Workers Scripts settings
      // API). Declaring them here fails every `wrangler deploy --env
      // production` at bucket validation before the script uploads. Code
      // paths fail open without the bindings (files/memory/metrics no-op).
      // Re-add after enabling R2:
      //   r2_buckets: FILES_BUCKET → oma-managed-agents-files,
      //               MEMORY_BUCKET → oma-managed-agents-memory
      //   analytics_engine_datasets: ANALYTICS → oma_events
      //   queues.consumers: oma-managed-agents-memory-events (+ dlq)
      // Single-D1 launch layout (no sharding — zero users yet, sharding is
      // premature). MAIN_DB holds all tenant + control-plane data; the router
      // tables (tenant_shard / shard_pool / memory_store_tenant) are now folded
      // into apps/main/migrations itself (see 0001_router_tables.sql) via the
      // ROUTER_DB ?? MAIN_DB fallback — setup-cf-production.sh applies only
      // apps/main/migrations to oma-auth; migrations-router/ is reserved for
      // a genuinely separate ROUTER_DB in real multi-shard mode.
      // AUTH_DB_01 is deliberately absent, so buildCfTenantDbProvider() selects
      // the non-sharded CfSharedAuthDbProvider. INTEGRATIONS_DB stays its own
      // database (oma-integrations). To scale out later, re-add ROUTER_DB +
      // AUTH_DB_00..03 (see git history / env.staging) and split the shards.
      "d1_databases": [
        { "binding": "MAIN_DB",         "database_name": "oma-auth",         "database_id": "c0f61e65-4e87-4561-91b7-a590313259b8" },
        { "binding": "INTEGRATIONS_DB", "database_name": "oma-integrations", "database_id": "6ccdebc5-5503-4e84-8d29-cabd87d136bb", "migrations_dir": "migrations-integrations" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RUNTIME_ROOM", "class_name": "RuntimeRoom" }
        ]
      },
      "send_email": [
        { "name": "SEND_EMAIL" }
      ],
      "ai": { "binding": "AI" },
      // USAGE_METER / USAGE_METER_HTTP (service: managed-agents-billing) are
      // intentionally omitted — the billing worker lives in a separate private
      // repo and the platform launches WITHOUT usage metering. Both consumer
      // sites fail open when the binding is absent: preCreateGate in
      // apps/main/src/lib/cf-session-lifecycle.ts returns null (sessions still
      // start) and the /billing-api/* proxy in src/index.ts returns 404. Matches
      // env.staging, which never bound the meter either.
      "services": [
        { "binding": "SANDBOX_sandbox_default", "service": "oma-sandbox-default" },
        { "binding": "INTEGRATIONS", "service": "oma-managed-agents-integrations" }
      ],
      // cpu_ms requires Workers Paid. Account currently rejects it with
      // code 100328 ("CPU limits are not supported for the Free plan").
      // Re-add after upgrading: "limits": { "cpu_ms": 300000 }
      "observability": { "enabled": true },
      "ratelimits": [
        { "name": "RL_AUTH_IP",         "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_AUTH_SEND_IP",    "namespace_id": "1002", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RL_AUTH_SEND_EMAIL", "namespace_id": "1003", "simple": { "limit": 1,  "period": 60 } },
        { "name": "RL_API_USER_WRITE",  "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_API_USER_READ",   "namespace_id": "1005", "simple": { "limit": 600,"period": 60 } },
        { "name": "RL_SESSIONS_TENANT", "namespace_id": "1006", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RL_UPLOAD_TENANT",   "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_MAGICLINK_EMAIL", "namespace_id": "1008", "simple": { "limit": 1,  "period": 60 } },
        { "name": "RL_MCP_PROXY_TENANT","namespace_id": "1009", "simple": { "limit": 300,"period": 60 } }
      ],
      // Free plan allows 5 cron triggers per *account*. Setting these on
      // deploy currently fails with 10072 when the account is already at the
      // free ceiling (other workers share the budget). Live worker already
      // has its schedules; re-add after Workers Paid:
      // "triggers": { "crons": ["* * * * *", "0 */6 * * *"] }
    },
    "staging": {
      "name": "oma-managed-agents-staging",
      "vars": {
        "INTEGRATIONS_ORIGIN": "https://integrations.staging.oma.duyet.net"
      },
      "routes": [
        { "pattern": "app.staging.oma.duyet.net", "custom_domain": true }
      ],
      "kv_namespaces": [
        { "binding": "CONFIG_KV", "id": "f91ddab8abe64941bd3ef398b0c187a7" }
      ],
      "d1_databases": [
        { "binding": "MAIN_DB",    "database_name": "oma-auth-staging",          "database_id": "aff5dbb7-36f9-46b7-b82f-4513e5603ac6" },
        { "binding": "ROUTER_DB",  "database_name": "oma-router-staging",        "database_id": "c238a338-9b6e-40c5-aaaa-48d4fe6dc63d" },
        { "binding": "AUTH_DB_00", "database_name": "oma-auth-staging",          "database_id": "aff5dbb7-36f9-46b7-b82f-4513e5603ac6" },
        { "binding": "AUTH_DB_01", "database_name": "oma-auth-shard-01-staging", "database_id": "fe6a34d1-cd8a-48a1-bff1-29032026d006" },
        { "binding": "AUTH_DB_02", "database_name": "oma-auth-shard-02-staging", "database_id": "8636a018-8ac6-48c2-ae95-2f70919c8aab" },
        { "binding": "AUTH_DB_03", "database_name": "oma-auth-shard-03-staging", "database_id": "8ce8f17d-7527-4a5a-b097-ce73251be55a" }
      ],
      "r2_buckets": [
        { "binding": "FILES_BUCKET", "bucket_name": "oma-managed-agents-files" },
        { "binding": "MEMORY_BUCKET", "bucket_name": "oma-managed-agents-memory-staging" }
      ],
      // Memory queue consumers intentionally NOT registered here for
      // staging — `managed-agents-lane-mem-anthropic` (lane worker)
      // owns them in this account and CF allows only one consumer per
      // queue. Re-add only if lane is decommissioned.
      "send_email": [
        { "name": "SEND_EMAIL" }
      ],
      "ai": { "binding": "AI" },
      "services": [
        { "binding": "SANDBOX_sandbox_default", "service": "oma-sandbox-default-staging" },
        { "binding": "INTEGRATIONS", "service": "oma-managed-agents-integrations-staging" }
        // USAGE_METER intentionally omitted on staging — packages/billing
        // isn't deployed there. The OSS contract is duck-typed optional,
        // so canStartSandbox/recordUsage soft-skip when binding is absent.
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RUNTIME_ROOM", "class_name": "RuntimeRoom" }
        ]
      },
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": true },
      "analytics_engine_datasets": [
        { "binding": "ANALYTICS", "dataset": "oma_events_staging" }
      ],
      "ratelimits": [
        { "name": "RL_AUTH_IP",         "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_AUTH_SEND_IP",    "namespace_id": "2002", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RL_AUTH_SEND_EMAIL", "namespace_id": "2003", "simple": { "limit": 1,  "period": 60 } },
        { "name": "RL_API_USER_WRITE",  "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_API_USER_READ",   "namespace_id": "2005", "simple": { "limit": 600,"period": 60 } },
        { "name": "RL_SESSIONS_TENANT", "namespace_id": "2006", "simple": { "limit": 5,  "period": 60 } },
        { "name": "RL_UPLOAD_TENANT",   "namespace_id": "2007", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_MAGICLINK_EMAIL", "namespace_id": "2008", "simple": { "limit": 1,  "period": 60 } },
        { "name": "RL_MCP_PROXY_TENANT","namespace_id": "2009", "simple": { "limit": 300,"period": 60 } }
      ]
    }
  }
}
