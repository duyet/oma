# Local-dev bootstrap key — same value as .env.example (Docker / self-host).
# README and docs/quickstart smoke tests grep API_KEY from the env file.
API_KEY=dev-test-key-change-me
# Placeholder only — a real provider key is required for a successful turn
# (or add a Model Card in the Console).
ANTHROPIC_API_KEY=sk-ant-xxx

# Required: at-rest encryption key for credentials.auth and
# model_cards.api_key_cipher. Workers throw at first request if missing.
# Generate with:  openssl rand -base64 32
PLATFORM_ROOT_SECRET=

# Optional: per-slug and per-IP daily caps on public (/p/:slug) session
# creation. KV-backed counter in publicSessionCaps. Defaults 50 / 20 when
# unset (see apps/main/src/routes/publications.ts).
PUBLIC_SESSION_CAP_PER_SLUG=
PUBLIC_SESSION_CAP_PER_IP=
