# Build artifacts
apps/agent/build-*
wrangler.deploy.jsonc
# Per-checkout deploy configs generated by scripts/setup-cf.sh — they hold
# this account's real D1/KV ids and origins. The tracked wrangler.jsonc files
# keep their <set-by-setup-cf-sh> placeholders.
apps/*/wrangler.local.jsonc
# Per-lane wrangler configs generated by scripts/lane-generate.mjs.
# Ephemeral — regenerate per deploy from the up-to-date prod config.
apps/*/wrangler.lane-*.jsonc
**/tsconfig.tsbuildinfo

